# Copy to .env and adjust. The backend loads it automatically on start
# (real environment variables win). For Docker: docker run --env-file .env ...

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Optional — defaults shown. Relative paths resolve from the backend's working directory.
# DATABASE_URL=sqlite://data/app.db
# STORAGE_DIR=data/files
# STATIC_DIR=../frontend/dist
# MAX_UPLOAD_MB=100
# Set to 1 when served over HTTPS
# COOKIE_SECURE=0
# PORT=3000
